    "space-4": {
      "$value": "24px"
    },
    "space-5": {
      "$value": "32px"
    },
    "space-6": {
      "$value": "48px"
    },
    "space-card-padding": {
      "$value": "var(--space-3)"
    },
    "space-card-gap": {
      "$value": "12px"
    },
    "space-screen-margin": {
      "$value": "20px"
    },
    "space-screen-margin-wide": {
      "$value": "var(--space-5)"
    }
