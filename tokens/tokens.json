    },
    "radius-l": {
      "$value": "16px",
      "$description": "cards, menus"
    },
    "radius-xl": {
      "$value": "20px",
      "$description": "daily columns, large containers"
    },
    "radius-2xl": {
      "$value": "24px",
      "$description": "modals, bottom bar"
    },
    "radius-device": {
      "$value": "30px"
    },
    "radius-full": {
      "$value": "999px"
    }
