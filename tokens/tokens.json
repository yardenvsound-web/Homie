    },
    "size-icon": {
      "$value": "24px"
    },
    "size-icon-stroke": {
      "$value": "1.75"
    },
    "size-icon-tile": {
      "$value": "36px"
    },
    "size-icon-tile-l": {
      "$value": "56px"
    },
    "size-stripe": {
      "$value": "4px"
    },
    "size-avatar-xs": {
      "$value": "24px"
    },
    "size-avatar-s": {
      "$value": "32px"
    },
    "size-avatar-m": {
      "$value": "48px"
    },
    "size-avatar-xl": {
      "$value": "56px"
    },
    "size-avatar-l": {
      "$value": "72px"
    }
