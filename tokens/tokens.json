  "font": {
    "font-family": {
      "$value": "'Noto Sans Hebrew', sans-serif",
      "$description": "body, buttons, fields, chips"
    },
    "font-family-heading": {
      "$value": "'Heebo', sans-serif",
      "$description": "headings"
    },
    "font-weight-regular": {
      "$value": "400"
    },
    "font-weight-medium": {
      "$value": "500"
    },
    "font-weight-semibold": {
      "$value": "600"
    },
    "font-weight-bold": {
      "$value": "700"
    },
    "font-display": {
      "$value": "700 32px/40px var(--font-family-heading)"
    },
    "font-title-l": {
      "$value": "700 24px/32px var(--font-family-heading)"
    },
    "font-title-m": {
      "$value": "600 20px/28px var(--font-family-heading)"
    },
    "font-title-s": {
      "$value": "600 16px/24px var(--font-family)"
    },
    "font-body": {
      "$value": "400 16px/26px var(--font-family)"
    },
    "font-caption": {
      "$value": "400 14px/20px var(--font-family)"
    },
    "font-label": {
      "$value": "600 16px/24px var(--font-family)"
    },
    "font-caption-xs": {
      "$value": "600 12px/16px var(--font-family)",
      "$description": "tags and badges only (approved 8.11.2026)"
    }
  },
  "space": {
    "space-1": {
      "$value": "4px"
    },
    "space-2": {
      "$value": "8px"
    },
    "space-3": {
      "$value": "16px"
