{
  "$description": "Home-me design tokens v1. Source: DESIGN.md. Values marked status=approved were added beyond the mockups and approved on 8.11.2026.",
  "color": {
    "neutral": {
      "bg":             { "$type": "color", "$value": "#F2EBE0", "$description": "נייר חם · screen background" },
      "surface":        { "$type": "color", "$value": "#FFFEFC", "$description": "לבן חם · cards, modals, fields, bars" },
      "border":         { "$type": "color", "$value": "#E6DFD3", "$description": "חול · lines, dividers, progress track" },
      "text":           { "$type": "color", "$value": "#2B2724", "$description": "פחם · headings and primary text" },
      "text-secondary": { "$type": "color", "$value": "#5A534B", "$description": "אפר · secondary text and icons" },
      "text-muted":     { "$type": "color", "$value": "#6B6258", "$description": "אבן · placeholder and notes" },
      "bg-done":        { "$type": "color", "$value": "#F7F3EC", "$description": "רקע מוחלש · completed task" },
      "line-dashed":    { "$type": "color", "$value": "#D8CFC0", "$description": "קו מקווקו · hour lines, device frame" },
      "border-field":   { "$type": "color", "$value": "#8A7F72", "$description": "מסגרת שדה · field and empty checkbox border" }
    },
    "earth": {
      "oat":        { "$type": "color", "$value": "#E9DFCE", "$description": "שיבולת · secondary button, todo chip, locked field" },
      "sage-light": { "$type": "color", "$value": "#E3EADC", "$description": "מרווה בהירה · done, active tab, member tint" },
      "clay-light": { "$type": "color", "$value": "#F4DFD5", "$description": "חרס בהיר · overlap and alert, member tint" },
      "sky-light":  { "$type": "color", "$value": "#DEE8EC", "$description": "שמיים אבקתיים · AI suggestion, member tint" },
      "butter":     { "$type": "color", "$value": "#F7EACB", "$description": "חמאה · pending, member tint" }
    },
    "accent": {
      "primary":         { "$type": "color", "$value": "#2F5A4A", "$description": "ירוק אשוח · primary button, +, logo, active link" },
      "primary-pressed": { "$type": "color", "$value": "#24473A", "$description": "Pressed primary", "$extensions": { "status": "approved" } },
      "sage":            { "$type": "color", "$value": "#6F9170", "$description": "מרווה · checked checkbox, progress" },
      "success-text":    { "$type": "color", "$value": "#38663F", "$description": "Text on sage-light" },
      "danger":          { "$type": "color", "$value": "#A33B2B", "$description": "אדום לבנים · alert icon, counter" },
      "danger-text":     { "$type": "color", "$value": "#9A3B28", "$description": "Text on clay-light" },
      "terracotta":      { "$type": "color", "$value": "#CB7A56", "$description": "Member stripe" },
      "mustard":         { "$type": "color", "$value": "#D6A23E", "$description": "Member stripe" },
      "powder-blue":     { "$type": "color", "$value": "#6C93A6", "$description": "Member stripe" }
    },
    "scrim": { "$type": "color", "$value": "rgba(43, 39, 36, 0.38)", "$description": "Overlay behind modals" }
  },
  "member": {
    "yoav": { "tint": { "$type": "color", "$value": "{color.earth.sage-light}" }, "stripe": { "$type": "color", "$value": "{color.accent.sage}" } },
    "dana": { "tint": { "$type": "color", "$value": "{color.earth.clay-light}" }, "stripe": { "$type": "color", "$value": "{color.accent.terracotta}" } },
    "noa":  { "tint": { "$type": "color", "$value": "{color.earth.butter}" },     "stripe": { "$type": "color", "$value": "{color.accent.mustard}" } },
    "itai": { "tint": { "$type": "color", "$value": "{color.earth.oat}" },        "stripe": { "$type": "color", "$value": "{color.accent.powder-blue}" } }
  },
  "status": {
    "todo":    { "bg": { "$type": "color", "$value": "{color.earth.oat}" },        "fg": { "$type": "color", "$value": "{color.neutral.text}" } },
    "done":    { "bg": { "$type": "color", "$value": "{color.earth.sage-light}" }, "fg": { "$type": "color", "$value": "{color.accent.success-text}" } },
    "pending": { "bg": { "$type": "color", "$value": "{color.earth.butter}" },     "fg": { "$type": "color", "$value": "{color.neutral.text}" } },
    "overlap": { "bg": { "$type": "color", "$value": "{color.earth.clay-light}" }, "fg": { "$type": "color", "$value": "{color.accent.danger-text}" } },
    "ai":      { "bg": { "$type": "color", "$value": "{color.earth.sky-light}" },  "fg": { "$type": "color", "$value": "{color.neutral.text}" } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Assistant", "sans-serif"] },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "display":    { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 700 }, "$description": "Product name" },
    "title-l":    { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700 }, "$description": "Screen title" },
    "title-m":    { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 700 }, "$description": "Section title" },
    "title-s":    { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 }, "$description": "Card title" },
    "body":       { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "26px", "fontWeight": 400 }, "$description": "Body text" },
    "caption":    { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 }, "$description": "Meta and captions" },
    "label":      { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600 }, "$description": "Button" },
    "caption-xs": { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600 }, "$description": "Tags and badges only (below the 14px minimum)", "$extensions": { "status": "approved" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "16px" },
    "4": { "$type": "dimension", "$value": "24px" },
    "5": { "$type": "dimension", "$value": "32px" },
    "6": { "$type": "dimension", "$value": "48px" },
    "card-padding":   { "$type": "dimension", "$value": "{space.3}" },
    "card-gap":       { "$type": "dimension", "$value": "{space.3}" },
    "screen-margin":  { "$type": "dimension", "$value": "20px" }
  },
  "radius": {
    "s":      { "$type": "dimension", "$value": "6px",   "$description": "Chips and blocks" },
    "m":      { "$type": "dimension", "$value": "10px",  "$description": "Buttons and fields" },
    "l":      { "$type": "dimension", "$value": "12px",  "$description": "Cards, modals, containers" },
    "check":  { "$type": "dimension", "$value": "5px",   "$description": "Checkbox" },
    "device": { "$type": "dimension", "$value": "30px",  "$description": "Phone frame in mockups" },
    "full":   { "$type": "dimension", "$value": "999px", "$description": "Avatars and + button" }
  },
  "shadow": {
    "none": { "$type": "shadow", "$value": "none" },
    "xs":   { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px",  "spread": "0px", "color": "rgba(43, 39, 36, 0.06)" }, "$description": "Cards" },
    "soft": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px", "color": "rgba(43, 39, 36, 0.08)" }, "$description": "Floating panels and + button" }
  },
  "size": {
    "button-height": { "$type": "dimension", "$value": "48px" },
    "touch-target":  { "$type": "dimension", "$value": "44px" },
    "checkbox":      { "$type": "dimension", "$value": "24px" },
    "fab":           { "$type": "dimension", "$value": "56px", "$extensions": { "status": "approved" } },
    "icon":          { "$type": "dimension", "$value": "24px" },
    "icon-stroke":   { "$type": "number",    "$value": 1.5 },
    "stripe":        { "$type": "dimension", "$value": "4px" },
    "avatar": {
      "xs": { "$type": "dimension", "$value": "24px" },
      "s":  { "$type": "dimension", "$value": "32px" },
      "m":  { "$type": "dimension", "$value": "48px" },
      "l":  { "$type": "dimension", "$value": "72px" }
    }
  },
  "focus": {
    "ring-width":  { "$type": "dimension", "$value": "2px" },
    "ring-offset": { "$type": "dimension", "$value": "2px" },
    "ring-color":  { "$type": "color", "$value": "{color.accent.primary}" },
    "field-halo":  { "$type": "color", "$value": "{color.earth.sage-light}" }
  }
}
